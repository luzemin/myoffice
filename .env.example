# Copy this file to .env and tweak values for your local setup.
# Every variable is optional - the docker-compose.yml file ships sane defaults.

# ---- Host ports (change if these collide with anything on the host) ----
APP_CLIENT_HOST_PORT=3000
APP_SERVER_HOST_PORT=8080
ONLYOFFICE_HOST_PORT=8088
MYSQL_HOST_PORT=3306

# ---- Secrets ----
MYSQL_ROOT_PASSWORD=myoffice123
# This MUST match the value the backend uses to talk to OnlyOffice.
ONLYOFFICE_JWT_SECRET=my_jwt_secret
